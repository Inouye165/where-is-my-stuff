# WhereIsMyStuff (WIMS) - Environment Configuration Template
# Copy this file to .env and adjust values as needed.

APP_NAME="WhereIsMyStuff (WIMS) Inventory"
APP_ENV="production"
HOST="0.0.0.0"
PORT=8000
# Optional local HTTPS companion port for mobile camera access (getUserMedia requires HTTPS on non-localhost LAN origins)
HTTPS_ENABLED="true"
HTTPS_PORT=8443

# Leave blank to default to <repo>/data and sqlite:///<repo>/data/inventory.db
# DATA_DIR=""
# DATABASE_URL="sqlite:///data/inventory.db"

# Optional override for QR deep links (e.g., Tailscale MagicDNS or custom LAN IP)
# PUBLIC_BASE_URL="http://192.168.1.50:8000"

# Comma-separated CORS origins (leave empty to allow same-origin requests only)
CORS_ALLOWED_ORIGINS=""

# Optional LAN access PIN/passcode (leave empty to disable login prompt on trusted home LAN)
WIMS_ACCESS_PIN=""
# Set true to let localhost/127.0.0.1 bypass the PIN prompt while still protecting LAN clients
WIMS_AUTH_BYPASS_LOCALHOST="false"
# Optional persistent HMAC secret for session cookies (auto-generated per process if unset)
WIMS_SESSION_SECRET=""
# Per-IP sliding-window rate limiting on auth, uploads, vision AI, and system endpoints
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_VISION_PER_MIN=15
RATE_LIMIT_SYSTEM_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=180

# Upload & image safety limits
MAX_IMAGE_UPLOAD_SIZE_MB=15
MAX_IMAGE_DIMENSION=1600
MAX_LABEL_SCAN_DIMENSION=4096
THUMBNAIL_MAX_DIMENSION=400
MAX_IMAGE_PIXELS=36000000

# Logging & Backups
LOG_LEVEL="INFO"
BACKUP_RETENTION_COUNT=10
AUTO_BACKUP_ENABLED="true"
AUTO_BACKUP_INTERVAL_HOURS=24

# Vision AI Configuration ("local" uses Ollama with no API key; "gemini" or "openai" optional)
VISION_PROVIDER="local"
OLLAMA_BASE_URL="http://localhost:11434"
# Any installed Ollama vision model can be configured here (default: qwen2.5vl:7b)
OLLAMA_VISION_MODEL="qwen2.5vl:7b"

# Optional Cloud Vision API keys & models
GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
